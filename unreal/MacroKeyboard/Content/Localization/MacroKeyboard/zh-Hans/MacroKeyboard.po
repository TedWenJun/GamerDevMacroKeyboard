#. Key:	EMacroEditorAction
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction [Enum ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction [Enum ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction"
msgid "What a control does in a given editor context."
msgstr "控件在某个编辑器上下文中执行的动作。"

#. Key:	EMacroEditorAction.Chord
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:Chord [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:Chord [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.Chord"
msgid "Chord"
msgstr "快捷键"

#. Key:	EMacroEditorAction.Chord
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:Chord [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:Chord [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.Chord"
msgid "Send a keyboard shortcut inside Unreal (Slate routing, not the operating system)."
msgstr "在 Unreal 内部发送键盘快捷键（经 Slate 路由，不经过操作系统）。"

#. Key:	EMacroEditorAction.ConsoleCommand
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:ConsoleCommand [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:ConsoleCommand [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.ConsoleCommand"
msgid "Console Command"
msgstr "控制台命令"

#. Key:	EMacroEditorAction.ConsoleCommand
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:ConsoleCommand [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:ConsoleCommand [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.ConsoleCommand"
msgid "Execute a console / editor command, e.g. \"stat fps\"."
msgstr "执行控制台 / 编辑器命令，例如 \"stat fps\"。"

#. Key:	EMacroEditorAction.EMacroEditorAction_MAX
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:EMacroEditorAction_MAX [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:EMacroEditorAction_MAX [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.EMacroEditorAction_MAX"
msgid "EMacro Editor Action MAX"
msgstr ""

#. Key:	EMacroEditorAction.None
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:None [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:None [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.None"
msgid "None"
msgstr "无"

#. Key:	EMacroEditorAction.None
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:None [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:None [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.None"
msgid "Nothing (use to shadow a broader binding in one context)."
msgstr "什么都不做（用于在某个上下文里屏蔽更通用的绑定）。"

#. Key:	EMacroEditorAction.TimelinePlayPause
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:TimelinePlayPause [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:TimelinePlayPause [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.TimelinePlayPause"
msgid "Timeline Play Pause"
msgstr "时间轴播放/暂停"

#. Key:	EMacroEditorAction.TimelinePlayPause
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:TimelinePlayPause [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:TimelinePlayPause [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.TimelinePlayPause"
msgid "Play or pause the Sequencer / animation preview."
msgstr "播放或暂停 Sequencer / 动画预览。"

#. Key:	EMacroEditorAction.TimelineScrub
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:TimelineScrub [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:TimelineScrub [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.TimelineScrub"
msgid "Timeline Scrub"
msgstr "时间轴拖动"

#. Key:	EMacroEditorAction.TimelineScrub
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:TimelineScrub [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:TimelineScrub [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.TimelineScrub"
msgid "Move the Sequencer playhead / animation preview time. Rotary controls scrub by their turn direction."
msgstr "移动 Sequencer 播放头 / 动画预览时间。旋转类控件按旋转方向拖动。"

#. Key:	EMacroEditorAction.UICommand
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:UICommand [EnumEntry DisplayName meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:UICommand [EnumEntry DisplayName meta-data]
msgctxt "UObjectDisplayNames,EMacroEditorAction.UICommand"
msgid "UICommand"
msgstr "编辑器命令"

#. Key:	EMacroEditorAction.UICommand
#. SourceLocation:	/Script/MacroKeyboardEditor.EMacroEditorAction:UICommand [EnumEntry ToolTip meta-data]
#: /Script/MacroKeyboardEditor.EMacroEditorAction:UICommand [EnumEntry ToolTip meta-data]
msgctxt "UObjectToolTips,EMacroEditorAction.UICommand"
msgid "Look the shortcut up by command name and send it — survives users rebinding the command."
msgstr "按命令名查找快捷键再发送——用户改了快捷键也能用。"

#. Key:	MacroContextLighting
