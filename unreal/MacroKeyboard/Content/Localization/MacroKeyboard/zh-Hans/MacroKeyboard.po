msgid "Lighting"
msgstr "灯光"

#. Key:	MacroContextLighting:Context
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroContextLighting:Context [StrProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroContextLighting:Context [StrProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroContextLighting:Context"
msgid "Context"
msgstr "上下文"

#. Key:	MacroContextLighting:Context
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroContextLighting:Context [StrProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroContextLighting:Context [StrProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroContextLighting:Context"
msgid "Context id; empty applies to every context that has none of its own."
msgstr "上下文 id；留空则用于所有没有专用灯光的上下文。"

#. Key:	MacroContextLighting:Lighting
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroContextLighting:Lighting [StructProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroContextLighting:Lighting [StructProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroContextLighting:Lighting"
msgid "Lighting"
msgstr "灯光"

#. Key:	MacroKeyboardBinding
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding [ScriptStruct DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding [ScriptStruct DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding"
msgid "Macro Keyboard Binding"
msgstr "宏键盘绑定"

#. Key:	MacroKeyboardBinding
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding [ScriptStruct ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding [ScriptStruct ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding"
msgid "One binding: \"in this context, this control does this\".\nContext matching is exact; leave it empty to apply in every context that has no more specific binding."
msgstr "一条绑定：“在这个上下文里，这个控件做这件事”。\n上下文精确匹配；留空则用于所有没有更具体绑定的上下文。"

#. Key:	MacroKeyboardBinding:Action
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Action [EnumProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Action [EnumProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:Action"
msgid "Action"
msgstr "动作"

#. Key:	MacroKeyboardBinding:Amount
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Amount [FloatProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Amount [FloatProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:Amount"
msgid "Amount"
msgstr "帧数"

#. Key:	MacroKeyboardBinding:Amount
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Amount [FloatProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Amount [FloatProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:Amount"
msgid "Frames per trigger; rotary controls use the direction of the turn (Action = TimelineScrub)."
msgstr "每次触发移动的帧数；旋转类控件按旋转方向（动作 = 时间轴拖动）。"

#. Key:	MacroKeyboardBinding:bOnRelease
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:bOnRelease [BoolProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:bOnRelease [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:bOnRelease"
msgid "On Release"
msgstr "松开时触发"

#. Key:	MacroKeyboardBinding:bOnRelease
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:bOnRelease [BoolProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:bOnRelease [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:bOnRelease"
msgid "Run on release instead of press."
msgstr "在松开时而不是按下时执行。"

#. Key:	MacroKeyboardBinding:bSpeedAcceleration
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:bSpeedAcceleration [BoolProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:bSpeedAcceleration [BoolProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:bSpeedAcceleration"
msgid "Speed Acceleration"
msgstr "快转加速"

#. Key:	MacroKeyboardBinding:bSpeedAcceleration
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:bSpeedAcceleration [BoolProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:bSpeedAcceleration [BoolProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:bSpeedAcceleration"
msgid "Rotary controls: turning quickly moves further per detent (2x under 90 ms, 5x under 40 ms between detents)."
msgstr "旋转类控件：转得快时每格走得更远（格间隔 < 90 ms ×2，< 40 ms ×5）。"

#. Key:	MacroKeyboardBinding:Chord
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Chord [StructProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Chord [StructProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:Chord"
msgid "Chord"
msgstr "快捷键"

#. Key:	MacroKeyboardBinding:Chord
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Chord [StructProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Chord [StructProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:Chord"
msgid "Shortcut to send (Action = Chord)."
msgstr "要发送的快捷键（动作 = 快捷键）。"

#. Key:	MacroKeyboardBinding:CommandContext
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandContext [NameProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandContext [NameProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:CommandContext"
msgid "Command Context"
msgstr "命令上下文"

#. Key:	MacroKeyboardBinding:CommandContext
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandContext [NameProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandContext [NameProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:CommandContext"
msgid "Binding context of the command, e.g. \"LevelEditor\", \"Sequencer\" (Action = UICommand)."
msgstr "命令所属的绑定上下文，例如 \"LevelEditor\"、\"Sequencer\"（动作 = 编辑器命令）。"

#. Key:	MacroKeyboardBinding:CommandName
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandName [NameProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandName [NameProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:CommandName"
msgid "Command Name"
msgstr "命令名"

#. Key:	MacroKeyboardBinding:CommandName
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandName [NameProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:CommandName [NameProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:CommandName"
msgid "Command name inside that context, e.g. \"Undo\" (Action = UICommand)."
msgstr "该上下文中的命令名，例如 \"Undo\"（动作 = 编辑器命令）。"

#. Key:	MacroKeyboardBinding:ConsoleCommand
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:ConsoleCommand [StrProperty DisplayName meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:ConsoleCommand [StrProperty DisplayName meta-data]
msgctxt "UObjectDisplayNames,MacroKeyboardBinding:ConsoleCommand"
msgid "Console Command"
msgstr "控制台命令"

#. Key:	MacroKeyboardBinding:ConsoleCommand
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:ConsoleCommand [StrProperty ToolTip meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:ConsoleCommand [StrProperty ToolTip meta-data]
msgctxt "UObjectToolTips,MacroKeyboardBinding:ConsoleCommand"
msgid "Console / editor command (Action = ConsoleCommand)."
msgstr "控制台 / 编辑器命令（动作 = 控制台命令）。"

#. Key:	Binding
#. SourceLocation:	/Script/MacroKeyboardEditor.MacroKeyboardBinding:Context [StrProperty Category meta-data]
#: /Script/MacroKeyboardEditor.MacroKeyboardBinding:Context [StrProperty Category meta-data]
